{
    "version": "2.0.0",
    "options": {
        "env": {
            "PATH": "C:\\ST\\STM32CubeCLT_1.22.0\\Ninja\\bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "CMake Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/Debug",
                "--target",
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "Flash (Debug)",
            "type": "shell",
            "command": "C:\\ST\\STM32CubeCLT_1.22.0\\STM32CubeProgrammer\\bin\\STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",
                "-d",
                "${workspaceFolder}/build/Debug/WS2812_STM32H7.elf",
                "-rst"
            ],
            "dependsOn": [
                "Build (Debug)"
            ],
            "problemMatcher": []
        }
    ]
}